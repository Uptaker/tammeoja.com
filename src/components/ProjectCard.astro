---
import ArrowLink from './ArrowLink.astro';

interface Props {
  number: string;
  name: string;
  logo: string;
  logoText?: string;
  kind: string;
  description: string[];
  tags: string[];
  url: string;
  linkLabel: string;
}

const { number, name, logo, logoText, kind, description, tags, url, linkLabel } = Astro.props;
---

<article class="project-card">
  <div class="project-top"><span>{number} / SELECTED WORK</span><span>{kind}</span></div>
  <div class="project-bottom">
    <div>
      <h3 class="project-heading">{logoText ? <span class="project-brand"><img src={logo} width="72" height="60" alt="" loading="lazy" /><span>{logoText}</span></span> : <img class="project-wordmark" src={logo} width="740" height="88" alt={name} loading="lazy" />}</h3>
      <div class="project-description">{description.map((paragraph) => <p>{paragraph}</p>)}</div>
      <ul class="tag-list project-tags" aria-label={`${name} technologies`}>{tags.map((tag) => <li>{tag}</li>)}</ul>
    </div>
    <ArrowLink href={url} label={linkLabel} />
  </div>
</article>
