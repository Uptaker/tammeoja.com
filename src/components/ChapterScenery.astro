<script>
  import { unlock } from '../scripts/achievements';

  const valve = document.querySelector<HTMLButtonElement>('.valve-wheel');
  const pipeBay = document.querySelector<HTMLElement>('.pipe-bay');

  if (valve && pipeBay) {
    let ventTimer: number;
    valve.addEventListener('click', () => {
      unlock('valve-time');
      pipeBay.classList.remove('is-venting');
      void pipeBay.offsetWidth;
      pipeBay.classList.add('is-venting');
      window.clearTimeout(ventTimer);
      ventTimer = window.setTimeout(() => pipeBay.classList.remove('is-venting'), 2100);
    });
  }

  const terminal = document.querySelector<HTMLElement>('.chamber-terminal');
  const terminalMessage = document.querySelector<HTMLElement>('.terminal-message');
  const terminalSector = document.querySelector<HTMLElement>('.terminal-sector');
  const terminalReadout = document.querySelector<HTMLElement>('.terminal-readout');

  if (terminal && terminalMessage && terminalSector && terminalReadout && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const messages = [
      { sector: 'SECTOR 04 / MAINTENANCE', message: 'CHAMBER 02 / PANEL JAM', readout: 'SIGNAL DEGRADED _' },
      { sector: 'DEPLOYMENT / CHAMBER 03', message: 'BUILD GREEN. ROOM ON FIRE.', readout: 'ROLLBACK PENDING _' },
      { sector: 'MONITORING / LIVE METRICS', message: 'ALL SYSTEMS NOMINAL*', readout: '*EXCEPT THE SENTRY _' },
      { sector: 'CI/CD / TEST TRACK', message: '19 TESTS PASSED. 1 ESCAPED.', readout: 'CONTAINMENT: RETRYING _' },
      { sector: 'PAIR PROGRAMMING / 02', message: 'YOUR PARTNER IS A CUBE.', readout: 'REVIEW REQUESTED _' },
      { sector: 'OBSERVABILITY / SENTRY 03', message: 'NO SIGNAL. VERY LOUD GUNFIRE.', readout: 'SEVERITY: MEDIUM _' },
      { sector: 'SECTOR 04 / OVERGROWTH', message: 'VEGETATION INTAKE: 84%', readout: 'MAINTENANCE DELAYED _' },
    ];
    let current = 0;
    window.setInterval(() => {
      current = (current + 1) % messages.length;
      terminalSector.textContent = messages[current].sector;
      terminalMessage.textContent = messages[current].message;
      terminalReadout.textContent = messages[current].readout;
      terminal.classList.remove('is-switching');
      void terminal.offsetWidth;
      terminal.classList.add('is-switching');
    }, 4200);
  }
</script>

