    <path d="M37 45h225M36 47l12 4m8-8 9 2m157 1 17 4M48 84h214M45 275h217" fill="none" stroke="#6d8582" stroke-width="2" opacity=".4" />
    <image href="/lambda-graffiti.png" x="26" y="42" width="108" height="108" opacity=".84" />
