  {kind === 'swappie' && <TurretDuo />}

  {kind === 'codeborne' && <>
  <div class="pipe-bay">
    <svg class="pipe-work" viewBox="0 0 300 250" aria-hidden="true" focusable="false">
      <path d="M20 140h92V98h74v42h95" fill="none" stroke="#536e70" stroke-width="22" stroke-linejoin="round" opacity=".58" />
