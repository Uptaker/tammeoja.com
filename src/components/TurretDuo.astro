---
const turrets = [{ id: 'a', x: 4 }, { id: 'b', x: 129 }];
---

<button class="turret-stage is-playing" type="button" aria-label="Replay the turret incident">
  <svg viewBox="0 0 300 245" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="wheatley-shell" cx="35%" cy="28%" r="75%">
        <stop offset="0" stop-color="#f6f6ef" />
        <stop offset=".63" stop-color="#d7dddb" />
        <stop offset="1" stop-color="#859494" />
      </radialGradient>
      <radialGradient id="wheatley-blue" cx="45%" cy="44%" r="60%">
        <stop offset="0" stop-color="#e3ffff" />
        <stop offset=".22" stop-color="#53d9ff" />
        <stop offset=".65" stop-color="#2374d2" />
        <stop offset="1" stop-color="#102f66" />
      </radialGradient>
    </defs>
    <path d="M8 22h284v201H8z" fill="#d4dfd9" opacity=".4" />
    <path d="M8 22h284M8 116h284M8 222h284M100 22v200m100-200v200" fill="none" stroke="#9cafaa" stroke-width="2" opacity=".45" />
    <path d="M15 73h8m4 0h8" stroke="#b77256" stroke-width="2" />
    <text x="15" y="65" fill="#526d70" font-family="monospace" font-size="9" font-weight="700" letter-spacing="1.1">SENTRY TEST / 02</text>
    <path d="M65 34h229v10H65z" fill="#a9bdb6" stroke="#657e7d" stroke-width="2" />
    <path d="M70 37h217" stroke="#e4ebe2" stroke-width="2" opacity=".8" />
    <path d="M80 44v6m60-6v6m60-6v6m60-6v6" stroke="#617a79" stroke-width="2" />
    <path d="M12 220h276" stroke="#647d7b" stroke-width="3" opacity=".8" />
    <path d="M105 216h33m-23-5h13M229 216h24" stroke="#a0b4ac" stroke-width="2" opacity=".7" />
    <g class="reset-wall">
      <path d="M240 61h86v159h-86z" fill="#9bada8" stroke="#526b6d" stroke-width="3" />
      <path d="M244 65h77v49h-77zM244 119h77v46h-77zM244 170h77v46h-77z" fill="#dfe6de" stroke="#708a88" stroke-width="2" />
      <path d="M248 70h66v38h-66zM248 124h66v35h-66zM248 175h66v35h-66z" fill="#c7d5cd" />
      <path d="M247 115h73m-73 51h73" stroke="#536c6d" stroke-width="5" />
      <path d="M241 72v137" stroke="#f1f3e9" stroke-width="3" opacity=".8" />
      <path d="M251 101h28m-28 51h28m-28 49h28" stroke="#8fa6a0" stroke-width="2" />
      <path d="m242 183 7-9m-7 20 7-9m-7 20 7-9" stroke="#b77a55" stroke-width="3" />
      <circle cx="255" cy="75" r="3" fill="#5c7777" /><circle cx="255" cy="203" r="3" fill="#5c7777" />
    </g>
    <g class="wheatley-rig">
      <path d="M114 43h28v9h-28z" fill="#536d70" stroke="#3f585b" stroke-width="2" />
      <circle cx="119" cy="47" r="3" fill="#b9cac2" /><circle cx="137" cy="47" r="3" fill="#b9cac2" />
      <path d="M128 52v46" stroke="#536d70" stroke-width="5" />
      <path d="M126 52v44" stroke="#bed0c8" stroke-width="1.5" />
      <g transform="translate(128 116) scale(.68) translate(-128 -116)">
        <g class="wheatley-shell">
          <path d="M100 103q3-21 28-23t28 23" fill="none" stroke="#24363d" stroke-width="6" stroke-linecap="round" />
          <path d="M101 102q3-18 27-20t27 20" fill="none" stroke="#6f8389" stroke-width="1.6" stroke-linecap="round" />
          <path d="M123 87h10v6h-10z" fill="#3a4e55" stroke="#24363d" stroke-width="1.5" />
          <circle cx="128" cy="116" r="25" fill="url(#wheatley-shell)" stroke="#33474f" stroke-width="2.5" />
          <path d="M104 108q24-9 48 0m-48 16q24 9 48 0" fill="none" stroke="#9aa9a8" stroke-width="1.3" />
          <path d="M112 96q10-6 22-4m12 8q5 5 6 11" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" opacity=".85" />
          <circle cx="107" cy="116" r="1.3" fill="#53676d" /><circle cx="149" cy="116" r="1.3" fill="#53676d" />
          <circle cx="128" cy="116" r="15.5" fill="#cfd8d5" stroke="#53686e" stroke-width="1.6" />
          <circle cx="128" cy="116" r="12.5" fill="#132028" stroke="#2c434c" stroke-width="1.6" />
          <g class="wheatley-eye">
            <circle cx="128" cy="116" r="9.5" fill="url(#wheatley-blue)" opacity=".35" />
            <circle cx="128" cy="116" r="7.5" fill="url(#wheatley-blue)" stroke="#1d5c9e" stroke-width="1" />
            <circle cx="128" cy="116" r="4.2" fill="none" stroke="#bff6ff" stroke-width="1" opacity=".7" />
            <circle cx="128" cy="116" r="2" fill="#e6ffff" />
            <circle cx="125" cy="113" r="1.2" fill="#fff" opacity=".9" />
          </g>
          <path class="wheatley-shutter" d="M114 110q14-13 28 0v-6q-14-9-28 0Z" fill="url(#wheatley-shell)" stroke="#3c535b" stroke-width="1.2" />
          <path d="M114 122q14 13 28 0v6q-14 9-28 0Z" fill="#dfe5e1" stroke="#53696f" stroke-width="1.2" />
          <path d="M100 129q3 21 28 23t28-23" fill="none" stroke="#24363d" stroke-width="6" stroke-linecap="round" />
          <path d="M101 130q3 18 27 20t27-20" fill="none" stroke="#6f8389" stroke-width="1.6" stroke-linecap="round" />
        </g>
      </g>
    </g>
    {turrets.map(({ id, x }) => (
      <g class:list={['turret', `turret-${id}`]} transform={`translate(${x} 126) scale(.37)`}>
        <g class="turret-motion">
          <g class="turret-legs">
            <path d="M108 219 115 222 103 258Z M192 219 185 222 197 258Z M146 222h8l-4 34Z" fill="#2e3f43" stroke="#2e3f43" stroke-width="3" stroke-linejoin="round" />
            <path d="M133 201c-11 2-21 9-27 19l9 3c4-8 11-12 19-13ZM167 201c11 2 21 9 27 19l-9 3c-4-8-11-12-19-13ZM144 208h12v15h-12Z" fill="#e5ebe4" stroke="#657d7f" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M136 206q-6 10 4 14" fill="none" stroke="#455d60" stroke-width="2" />
          </g>
          <g class="turret-barrels">
            <g class="barrel-left">
              <path d="M84 84h46v94H84z" fill="#2c4247" />
              <path d="M84 100h46M84 170h46" stroke="#455d60" stroke-width="3" />
              <path d="M93 115h22v50H93z" fill="#4b6265" stroke="#344b50" stroke-width="2" />
              <circle cx="104" cy="129" r="6" fill="#1c2c30" /><circle cx="104" cy="151" r="6" fill="#1c2c30" />
            </g>
            <g class="barrel-right">
              <path d="M170 84h46v94h-46z" fill="#2c4247" />
              <path d="M170 100h46M170 170h46" stroke="#455d60" stroke-width="3" />
              <path d="M185 115h22v50h-22z" fill="#4b6265" stroke="#344b50" stroke-width="2" />
              <circle cx="196" cy="129" r="6" fill="#1c2c30" /><circle cx="196" cy="151" r="6" fill="#1c2c30" />
            </g>
          </g>
          <g class="turret-wing turret-wing-left">
            <path d="M101 37C74 50 64 88 64 124s10 70 35 84c-9-16-13-48-13-84s4-68 15-87Z" fill="#e5ebe4" stroke="#657d7f" stroke-width="3" stroke-linejoin="round" />
            <path d="M98 44c-8 18-11 48-11 80s3 62 10 80" fill="none" stroke="#b9c8c2" stroke-width="5" />
            <path d="M80 58c-7 18-10 42-10 66 0 22 3 42 9 58" fill="none" stroke="#f7f8f1" stroke-width="4" opacity=".8" />
            <path d="M66 124h9" stroke="#455d60" stroke-width="3" />
          </g>
          <g class="turret-wing turret-wing-right">
            <path d="M199 37c27 13 37 51 37 87s-10 70-35 84c9-16 13-48 13-84s-4-68-15-87Z" fill="#e5ebe4" stroke="#657d7f" stroke-width="3" stroke-linejoin="round" />
            <path d="M202 44c8 18 11 48 11 80s-3 62-10 80" fill="none" stroke="#b9c8c2" stroke-width="5" />
            <path d="M225 124h9" stroke="#455d60" stroke-width="3" />
          </g>
          <g class="turret-core">
            <path d="M156 32V20l7-8V-4" fill="none" stroke="#5f7577" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M150 30c20 0 29 45 29 90 0 48-11 92-29 92s-29-44-29-92c0-45 9-90 29-90Z" fill="#ebefe8" stroke="#6c8585" stroke-width="3" />
            <path d="M150 32v79m0 36v63" stroke="#9fb1ab" stroke-width="2" />
            <path d="M137 52c-5 16-8 38-8 64" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".8" />
            <circle cx="150" cy="129" r="18" fill="#f4f6f1" stroke="#8fa3a0" stroke-width="2.5" />
            <circle cx="150" cy="129" r="12.5" fill="#2c4247" />
            <g class="turret-eye">
              <circle cx="150" cy="129" r="9.5" fill="#b84b3e" />
              <path d="M153.2 129.0L157.7 131.8M152.9 130.4L155.7 134.9M152.0 131.5L152.6 136.8M150.7 132.1L149.0 137.1M149.3 132.1L145.5 135.9M148.0 131.5L143.0 133.3M147.1 130.4L141.8 129.8M146.8 129.0L142.3 126.2M147.1 127.6L144.3 123.1M148.0 126.5L147.4 121.2M149.3 125.9L151.0 120.9M150.7 125.9L154.5 122.1M152.0 126.5L157.0 124.7M152.9 127.6L158.2 128.2" stroke="#7a271f" stroke-width="1.1" />
              <circle cx="150" cy="129" r="3" fill="#f0a07a" />
              <circle cx="147" cy="125.5" r="1.6" fill="#fbe2d6" />
            </g>
            <circle cx="150" cy="200" r="4.5" fill="#f4f6f1" stroke="#8fa3a0" stroke-width="2" />
          </g>
        </g>
      </g>
    ))}
    <path class="turret-scan" d="M84 174 132 136" stroke="#b85d50" stroke-width="1" />
    <g class="shot-lane shot-lane-a">
      <g class="bullet bullet-a-one"><path d="M87 173h8" stroke="#c85d45" stroke-width="2" stroke-linecap="round" /><circle cx="97" cy="173" r="2" fill="#efb574" /></g>
      <g class="bullet bullet-a-two"><path d="M87 176h8" stroke="#c85d45" stroke-width="2" stroke-linecap="round" /><circle cx="97" cy="176" r="2" fill="#efb574" /></g>
      <path class="muzzle-flash" d="m83 173 5-8 1 7 7 2-7 2-4 7-2-7-6-2Z" fill="#ed9a5d" />
      <path class="hit-spark" d="m132 136-4-5m4 5 5-2m-5 2 2 6" fill="none" stroke="#d6815d" stroke-width="2" />
    </g>
    <text class="turret-surprise" x="210" y="117" fill="#a96550" font-family="monospace" font-size="19" font-weight="700">!</text>
    <g class="shot-lane shot-lane-b">
      <g class="bullet bullet-b-one"><path d="M256 202h7" stroke="#c85d45" stroke-width="2" stroke-linecap="round" /><circle cx="265" cy="202" r="2" fill="#efb574" /></g>
      <g class="bullet bullet-b-two"><path d="M256 206h7" stroke="#c85d45" stroke-width="2" stroke-linecap="round" /><circle cx="265" cy="206" r="2" fill="#efb574" /></g>
      <path class="muzzle-flash" d="m253 202 5-7 1 6 6 2-6 2-4 6-2-6-5-2Z" fill="#ed9a5d" />
      <path class="hit-spark" d="m282 189-4-5m4 5 5-2m-5 2 2 6" fill="none" stroke="#d6815d" stroke-width="2" />
    </g>
    <path class="wall-jolt" d="m266 196-6-8m6 8-10 1m10-1-3 10" fill="none" stroke="#b67555" stroke-width="2" stroke-linecap="round" />
    <path d="M10 223h280" stroke="#bac9c0" stroke-width="2" />
    <text class="stage-caption" x="15" y="235" fill="#537378" font-family="monospace" font-size="8" font-weight="700" letter-spacing="1">CLICK TO REPLAY</text>
  </svg>
</button>

<script>
  import { unlock } from '../scripts/achievements';

  const stage = document.querySelector<HTMLButtonElement>('.turret-stage');
  if (stage && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    stage.disabled = true;
    stage.setAttribute('aria-label', 'Wheatley on a rail above two turrets and a movable wall');
  }
  stage?.addEventListener('click', () => {
    unlock('no-hard-feelings');
    stage.classList.remove('is-playing');
    void stage.offsetWidth;
    stage.classList.add('is-playing');
  });
</script>

<style>
  .turret-stage { position: absolute; bottom: 0; left: 0; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; pointer-events: auto; text-align: left; }
  .turret-stage svg { display: block; width: 100%; height: auto; }
  .turret-stage:focus-visible { outline: 2px solid #b66d51; outline-offset: -3px; }
  .stage-caption { opacity: .75; }
  .turret-stage:hover .stage-caption, .turret-stage:focus-visible .stage-caption { opacity: 1; }
  .wheatley-rig { transform: translateX(0); }
  .wheatley-shell { transform-origin: 128px 90px; }
  .wheatley-eye { transform-origin: 128px 116px; }
  .wheatley-shutter { transform-origin: 128px 104px; }
  .turret-motion { transform-origin: 150px 252px; }
  .turret-wing-left { transform-origin: 100px 140px; }
  .turret-wing-right { transform-origin: 200px 140px; }
  .turret-b .turret-wing-left { transform: translateX(52px); }
  .turret-b .turret-wing-right { transform: translateX(-52px); }
  .turret-b .barrel-left { transform: translateX(40px); }
  .turret-b .barrel-right { transform: translateX(-40px); }
  .turret-eye { transform-origin: 150px 129px; }
  .reset-wall { transform: translateX(40px); }
  .shot-lane, .turret-surprise, .wall-jolt, .turret-scan { opacity: 0; }
  .is-playing .wheatley-rig { animation: wheatley-glide 16s ease-in-out infinite; }
  .is-playing .wheatley-shell { animation: wheatley-swing 16s ease-in-out infinite; }
  .is-playing .wheatley-eye { animation: wheatley-look 16s ease-in-out infinite; }
  .is-playing .wheatley-shutter { animation: wheatley-shutter 16s ease-in-out infinite; }
  .is-playing .turret-a .turret-motion { animation: first-turret 16s ease-in-out infinite; }
  .is-playing .turret-b .turret-motion { animation: second-turret 16s ease-in-out infinite; }
  .is-playing .turret-a .turret-wing-left { animation: wing-a-left 16s ease-in-out infinite; }
  .is-playing .turret-a .turret-wing-right { animation: wing-a-right 16s ease-in-out infinite; }
  .is-playing .turret-b .turret-wing-left { animation: wing-b-left 16s ease-in-out infinite; }
  .is-playing .turret-b .turret-wing-right { animation: wing-b-right 16s ease-in-out infinite; }
  .is-playing .turret-b .barrel-left { animation: barrel-left-open 16s ease-in-out infinite; }
  .is-playing .turret-b .barrel-right { animation: barrel-right-open 16s ease-in-out infinite; }
  .is-playing .turret-a .turret-core, .is-playing .turret-a .turret-barrels { animation: first-recoil 16s ease-out infinite; }
  .is-playing .turret-b .turret-core { animation: second-recoil 16s ease-out infinite; }
  .is-playing .turret-b .turret-barrels { animation: second-recoil 16s ease-out infinite; }
  .is-playing .turret-a .turret-eye { animation: eye-a 16s ease-in-out infinite; }
  .is-playing .turret-b .turret-eye { animation: eye-b 16s ease-in-out infinite; }
  .is-playing .turret-scan { animation: scan-target 16s step-end infinite; }
  .is-playing .shot-lane-a { animation: firing-a 16s step-end infinite; }
  .is-playing .shot-lane-b { animation: firing-b 16s step-end infinite; }
  .is-playing .bullet-a-one, .is-playing .bullet-a-two { animation: shot-a .38s linear infinite; }
  .is-playing .bullet-b-one { animation: shot-b-high .38s linear infinite; }
  .is-playing .bullet-b-two { animation: shot-b-low .38s linear infinite; }
  .is-playing .bullet-a-two, .is-playing .bullet-b-two { animation-delay: -.19s; }
  .shot-lane-a .muzzle-flash { transform: rotate(-25deg); transform-origin: 85px 174px; }
  .is-playing .muzzle-flash, .is-playing .hit-spark { animation: flash .19s step-end infinite; }
  .is-playing .turret-surprise { animation: surprise 16s step-end infinite; }
  .is-playing .reset-wall { animation: wall-reset 16s ease-in-out infinite; }
  .is-playing .wall-jolt { animation: wall-contact 16s step-end infinite; }
  @keyframes wheatley-glide {
    0%, 5%, 100% { transform: translateX(190px); }
    13% { transform: translateX(52px); }
    18%, 19% { transform: translateX(0); }
    21% { transform: translate(-8px, -3px); }
    23% { transform: translate(9px, 3px); }
    26% { transform: translate(19px, -6px); }
    30% { transform: translateX(85px); }
    36%, 90% { transform: translateX(190px); }
  }
  @keyframes wheatley-swing {
    0%, 12%, 100% { transform: rotate(0); }
    18% { transform: rotate(-8deg); }
    21% { transform: rotate(12deg); }
    24% { transform: rotate(-15deg); }
    28% { transform: rotate(10deg); }
    36% { transform: rotate(-5deg); }
  }
  @keyframes wheatley-look {
    0%, 13%, 36%, 100% { transform: translateX(0) scale(1); filter: brightness(1); }
    17%, 19% { transform: translate(-1px, 1px) scale(.96); }
    21% { transform: translate(1px, -1px) scale(1.08); filter: brightness(1.35); }
    23% { transform: translate(-1px, 1px) scale(.82); filter: brightness(.7); }
    25% { transform: translate(1px, -1px) scale(1.08); filter: brightness(1.35); }
    29% { transform: translate(2px, -1px) scale(1.02); }
  }
  @keyframes wheatley-shutter {
    0%, 18%, 21%, 25%, 100% { transform: translateY(0); }
    23% { transform: translateY(3px); }
  }
  @keyframes first-turret {
    0%, 100% { transform: rotate(-3deg); }
    8% { transform: rotate(4deg); }
    13% { transform: rotate(-2deg); }
    17% { transform: rotate(-7deg); }
    20%, 22%, 24%, 26% { transform: rotate(-6deg); }
    21%, 23%, 25%, 27% { transform: rotate(-10deg); }
    32%, 53% { transform: rotate(-5deg); }
    72% { transform: rotate(3deg); }
    83% { transform: rotate(-5deg); }
  }
  @keyframes second-turret {
    0%, 100% { transform: rotate(1deg); }
    11% { transform: rotate(-3deg); }
    20% { transform: rotate(2deg); }
    23% { transform: rotate(-12deg); }
    26% { transform: rotate(9deg); }
    29% { transform: rotate(-8deg); }
    32% { transform: rotate(5deg); }
    37% { transform: rotate(77deg); }
    40% { transform: rotate(66deg); }
    42%, 55% { transform: rotate(74deg); }
    59% { transform: rotate(67deg); }
    65% { transform: rotate(27deg); }
    71% { transform: rotate(-9deg); }
    74% { transform: rotate(4deg); }
    78% { transform: rotate(0); }
  }
  @keyframes wing-a-left {
    0%, 15%, 31%, 100% { transform: translateX(0) rotate(0); }
    18%, 27% { transform: translateX(-12px) rotate(-7deg); }
    20%, 24% { transform: translateX(-8px) rotate(-4deg); }
    75% { transform: translateX(-3px) rotate(-2deg); }
  }
  @keyframes wing-a-right {
    0%, 15%, 31%, 100% { transform: translateX(0) rotate(0); }
    18%, 27% { transform: translateX(12px) rotate(7deg); }
    20%, 24% { transform: translateX(8px) rotate(4deg); }
    75% { transform: translateX(3px) rotate(2deg); }
  }
  @keyframes wing-b-left {
    0%, 18%, 100% { transform: translateX(52px) rotate(0); }
    24%, 30% { transform: translateX(-9px) rotate(-8deg); }
    34%, 57%, 81%, 90% { transform: translateX(0) rotate(0); }
    38% { transform: translateX(-16px) rotate(-12deg); }
    43%, 53% { transform: translateX(-10px) rotate(-8deg); }
    72% { transform: translateX(-7px) rotate(-5deg); }
  }
  @keyframes wing-b-right {
    0%, 18%, 100% { transform: translateX(-52px) rotate(0); }
    24%, 30% { transform: translateX(9px) rotate(8deg); }
    34%, 57%, 81%, 90% { transform: translateX(0) rotate(0); }
    38% { transform: translateX(16px) rotate(12deg); }
    43%, 53% { transform: translateX(10px) rotate(8deg); }
    72% { transform: translateX(7px) rotate(5deg); }
  }
  @keyframes barrel-left-open { 0%, 18%, 100% { transform: translateX(40px); } 24%, 90% { transform: translateX(0); } }
  @keyframes barrel-right-open { 0%, 18%, 100% { transform: translateX(-40px); } 24%, 90% { transform: translateX(0); } }
  @keyframes first-recoil {
    0%, 18%, 28%, 100% { transform: translateX(0); }
    20%, 22%, 24%, 26% { transform: translateX(-7px); }
    21%, 23%, 25%, 27% { transform: translateX(1px); }
  }
  @keyframes second-recoil {
    0%, 42%, 54%, 100% { transform: translateX(0); }
    44%, 47%, 50%, 53% { transform: translateX(-8px); }
    45%, 48%, 51% { transform: translateX(2px); }
  }
  @keyframes eye-a {
    0%, 10%, 100% { transform: translateX(-3px); filter: brightness(1); }
    15% { transform: translateX(4px); }
    18%, 28% { transform: translateX(2px); filter: brightness(1.7); }
    36%, 55% { transform: translateX(5px); filter: brightness(1); }
    82% { transform: translateX(-4px); }
  }
  @keyframes eye-b {
    0%, 15%, 100% { transform: translateX(2px); filter: brightness(1); }
    23% { transform: translateX(-5px); }
    37% { transform: translateX(4px); }
    42%, 54% { transform: translateX(3px); filter: brightness(1.7); }
    75% { transform: translateX(-4px); filter: brightness(1); }
  }
  @keyframes scan-target { 0%, 12%, 18%, 100% { opacity: 0; } 13%, 17% { opacity: .35; } }
  @keyframes firing-a { 0%, 18%, 28%, 100% { opacity: 0; } 19%, 27% { opacity: 1; } }
  @keyframes firing-b { 0%, 41%, 55%, 100% { opacity: 0; } 42%, 54% { opacity: 1; } }
  @keyframes shot-a { from { transform: translate(0, 0); opacity: 1; } to { transform: translate(43px, -38px); opacity: .45; } }
  @keyframes shot-b-high { from { transform: translate(0, 0); opacity: 1; } to { transform: translate(24px, -15px); opacity: .45; } }
