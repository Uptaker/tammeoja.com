---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortalLink from '../components/PortalLink.astro';
import ApertureMark from '../components/ApertureMark.astro';
---

<BaseLayout title="Chamber not found — Markus Tammeoja" description="This test chamber does not exist." noindex>
  <header class="site-header wrap">
    <a class="wordmark" href="/" aria-label="Markus Tammeoja, back to the homepage"><ApertureMark class="aperture-mark" /> MT<span>.</span></a>
  </header>

  <main class="chamber-missing wrap">
    <div class="chamber-missing-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> TEST CHAMBER / 404 · SIGNAL LOST</p>
      <h1>Chamber<br /><em>not found.</em></h1>
      <p class="hero-designation">ERROR 404 <span aria-hidden="true">/</span> THIS TEST CHAMBER DOES NOT EXIST</p>
      <p class="hero-intro">The Enrichment Center regrets to inform you that the chamber you were looking for has been moved, taken apart or was never built. Please return to the testing area.</p>
      <div class="hero-links"><PortalLink href="/" tone="orange" label="RETURN PORTAL" description="Enter the orange portal to return to the homepage" /></div>
    </div>
    <div class="rat-den" aria-hidden="true">
      <img src="/lambda-graffiti.webp" width="300" height="300" alt="" />
      <span class="rat-scrawl rat-scrawl-one">THE CAKE IS A LIE</span>
      <span class="rat-scrawl rat-scrawl-two">THE CAKE IS A LIE</span>
      <span class="rat-scrawl rat-scrawl-three">THE CAKE IS A LIE</span>
      <span class="rat-caption">SECTOR ? / BEHIND THE PANELS</span>
    </div>
  </main>

  <script>
    import { unlock } from '../scripts/achievements';

    unlock('lab-rat');
  </script>
</BaseLayout>
