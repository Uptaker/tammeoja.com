---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PortalLink from '../components/PortalLink.astro';
import ApertureMark from '../components/ApertureMark.astro';
import ChamberMonitor from '../components/ChamberMonitor.astro';
import CompanionCube from '../components/CompanionCube.astro';
import FooterGrunge from '../components/FooterGrunge.astro';
import FooterCats from '../components/FooterCats.astro';
import Elevator from '../components/Elevator.astro';
import CopyEmail from '../components/CopyEmail.astro';
import PrintCv from '../components/PrintCv.astro';
import AchievementProgress from '../components/AchievementProgress.astro';
import { experience, projects } from '../data/site';
---

<BaseLayout title="Markus Tammeoja — Software Engineer" description="Markus Tammeoja is a software engineer in Tallinn, Estonia. Work, projects, and a little about the things he likes to build.">
  <header class="site-header wrap">
    <a class="wordmark" href="#top" aria-label="Markus Tammeoja, back to top"><ApertureMark class="aperture-mark" /> MT<span>.</span></a>
    <nav aria-label="Main navigation">
      <a href="#experience"><span aria-hidden="true">01</span>Experience</a>
      <a href="#projects"><span aria-hidden="true">02</span>Projects</a>
      <a href="#about"><span aria-hidden="true">03</span>About</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> PERSONNEL FILE / 001 · TALLINN, ESTONIA</p>
        <h1 id="hero-title">Markus<br /><em>Tammeoja.</em></h1>
        <p class="hero-designation">SOFTWARE ENGINEER <span aria-hidden="true">/</span> BUILDER OF USEFUL THINGS</p>
        <p class="hero-intro">I build software across the stack, from the interfaces people use to the services and infrastructure behind them. I’ve worked on factory tools, financing products and energy apps, and I like getting close to the people who use what I make.</p>
        <div class="hero-links">
          <PortalLink href="#experience" tone="blue" label="EXPLORE MY WORK" description="Enter the blue portal to explore my work" />
        </div>
        <div class="hero-contact"><ArrowLink href="mailto:markus.tammeoja@gmail.com" label="Email" icon="mail" external={false} /><ArrowLink href="https://www.linkedin.com/in/tammeoja/" label="LinkedIn" icon="linkedin" /><ArrowLink href="https://github.com/Uptaker" label="GitHub" icon="github" /></div>
      </div>
      <ChamberMonitor />
    </section>

    <div class="marquee-rule wrap"><span><span class="lambda-mark" aria-hidden="true"><span>λ</span></span> CODE, PEOPLE, SYSTEMS</span><span>SCROLL TO EXPLORE ↓</span></div>

    <section class="section wrap" id="experience" aria-labelledby="experience-title">
      <div class="section-intro"><p class="section-label">01 / EXPERIENCE</p><div><h2 id="experience-title">The test log<span class="accent">.</span></h2><p>From university to the systems I work on today.</p></div></div>
      <div class="timeline">{experience.map((item) => <TimelineEntry {...item} />)}</div>
    </section>

    <CompanionCube />

    <section class="projects-section" id="projects" aria-labelledby="projects-title">
      <div class="wrap">
        <div class="section-intro"><p class="section-label">02 / PROJECTS</p><div><h2 id="projects-title">Out of the lab<span class="accent">.</span></h2><p>Selected apps and tools I've built and put to use.</p></div></div>
        <div class="projects-grid">{projects.map((project) => <ProjectCard {...project} />)}</div>
      </div>
    </section>

    <section class="about-section wrap" id="about" aria-labelledby="about-title">
      <div class="section-intro"><p class="section-label">03 / ABOUT</p><div><h2 id="about-title">Behind the panel<span class="accent">.</span></h2></div></div>
      <div class="about-grid">
        <div class="about-lead-wrap"><p class="about-lead">I like knowing how the whole thing works.</p><div class="specimen-chip" aria-hidden="true"><span class="specimen-sprite"><img src="/headcrab-hl2-v4.png" width="1120" height="88" alt="" loading="lazy" /></span><span>XEN / SPECIMEN 01</span></div></div>
        <div class="about-body">
          <p><strong>I daily-drive Linux</strong> and run services on my own servers. I like knowing how an app gets deployed, what happens when something breaks and how to make it easier to operate.</p>
          <p>I build my own things too. Ampsu is the biggest of them, and it lets me work on every part of a product, mostly in Kotlin, which is still my favourite language.</p>
          <p>Outside of work, I cycle, work out, hike and camp. I love food, board games and Magic: The Gathering. I'm a <a href="https://www.valvesoftware.com/en/about" target="_blank" rel="noopener noreferrer">Valve</a> fanatic (you may have noticed), and I always end up back in RuneScape eventually.</p>
        </div>
      </div>
      <div class="about-links"><ArrowLink href="https://www.linkedin.com/in/tammeoja/" label="LinkedIn" icon="linkedin" /><ArrowLink href="https://github.com/Uptaker" label="GitHub" icon="github" /><PortalLink href="#top" tone="orange" label="RETURN PORTAL" description="Enter the orange portal to return to the top" /></div>
    </section>
  </main>

  <footer class="site-footer">
    <FooterGrunge />
    <div class="wrap footer-inner">
      <div class="footer-top">
        <div><p class="footer-kicker">CONTACT <CopyEmail email="markus.tammeoja@gmail.com" /><PrintCv /></p><a class="footer-mail" href="mailto:markus.tammeoja@gmail.com">markus.tammeoja@gmail.com</a></div>
        <FooterCats />
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Markus Tammeoja</span><AchievementProgress /><Elevator /></div>
    </div>
  </footer>

  <script>
    console.log(
      String.raw`%c /\_/\
( o.o )
 > ^ <

Quest complete: you found the console.
The cats are at the bottom of the page.`,
      'color: #a9bca6; font: 14px monospace'
    );

    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });

      for (const entry of document.querySelectorAll('.timeline-entry')) {
        if (entry.getBoundingClientRect().top > window.innerHeight * .85) {
          entry.classList.add('reveal-ready');
          observer.observe(entry);
        }
      }
    }
  </script>
</BaseLayout>
