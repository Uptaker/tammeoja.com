---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PortalLink from '../components/PortalLink.astro';
import { experience, projects } from '../data/site';
---

<BaseLayout title="Markus Tammeoja — Software Engineer" description="Markus Tammeoja is a software engineer in Tallinn, Estonia. Work, projects, and a little about the things he likes to build.">
  <header class="site-header wrap">
    <a class="wordmark" href="#top" aria-label="Markus Tammeoja, back to top"><svg class="aperture-mark" viewBox="0 0 64 64" aria-hidden="true"><path d="M32 5 49.7 11.6 41.1 24.1 33.7 20.1Z M51.1 12.9 58.9 30.1 44 32.8 41.6 24.8Z M59 32 52.4 49.7 39.9 41.1 43.9 33.7Z M51.1 51.1 33.9 58.9 31.2 44 39.2 41.6Z M32 59 14.3 52.4 22.9 39.9 30.3 43.9Z M12.9 51.1 5.1 33.9 20 31.2 22.4 39.2Z M5 32 11.6 14.3 24.1 22.9 20.1 30.3Z M12.9 12.9 30.1 5.1 32.8 20 24.8 22.4Z"/></svg> MT<span>.</span></a>
    <nav aria-label="Main navigation">
      <a href="#experience">Experience</a>
      <a href="#projects">Projects</a>
      <a href="#about">About</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> PERSONNEL FILE / 001 · TALLINN, ESTONIA</p>
        <h1 id="hero-title">Markus<br /><em>Tammeoja.</em></h1>
        <p class="hero-designation">SOFTWARE ENGINEER <span aria-hidden="true">/</span> BUILDER OF USEFUL THINGS</p>
        <p class="hero-intro">I build software across the stack, from the interfaces people use to the services and infrastructure behind them. I’ve worked on factory tools, financing products and energy apps, and I like getting close to the people who use what I make.</p>
        <div class="hero-links">
          <PortalLink href="#experience" tone="blue" label="EXPLORE MY WORK" description="Enter the blue portal to explore my work" />
        </div>
        <div class="hero-contact"><ArrowLink href="mailto:markus.tammeoja@gmail.com" label="Email" external={false} /><ArrowLink href="https://www.linkedin.com/in/tammeoja/" label="LinkedIn" /><ArrowLink href="https://github.com/Uptaker" label="GitHub" /></div>
      </div>
      <div class="portrait-wrap">
        <div class="monitor-shell">
          <button class="monitor-display" type="button" disabled aria-label="Chamber monitor showing Markus Tammeoja. Pick up the crowbar to interact with it.">
            <img src="/markus-tammeoja.webp" width="786" height="1048" alt="Markus Tammeoja at a ceramics class" fetchpriority="high" />
            <span class="monitor-reticle" aria-hidden="true"></span>
            <span class="screen-failed" aria-hidden="true"></span>
            <span class="screen-static" aria-hidden="true"></span>
            <svg class="screen-pixel-lines" viewBox="0 0 500 580" preserveAspectRatio="none" aria-hidden="true"><path d="M69 0v580" stroke="#fa5368" stroke-width="3"/><path d="M119 0v580" stroke="#4eef8a" stroke-width="2"/><path d="M155 0v580m11 0V0m21 0v580m13 0V0m10 0v580m35 0V0m10 0v580m12 0V0m18 0v580m9 0V0m14 0v580m13 0V0m11 0v580m16 0V0m10 0v580m17 0V0m9 0v580m12 0V0m13 0v580m11 0V0" stroke="#174cfd" stroke-width="4"/><path d="M181 0v580m88 0V0m39 0v580m91 0V0m62 0v580" stroke="#27e1d7" stroke-width="1.5"/><path d="M276 0v580m80 0V0m52 0v580m37 0V0" stroke="#d449ff" stroke-width="2"/><path d="M294 0v580m8 0V0m56 0v580m8 0V0m47 0v580m20 0V0" stroke="#234bff" stroke-width="8" stroke-opacity=".65"/></svg>
            <svg class="screen-cracks" viewBox="0 0 500 580" preserveAspectRatio="none" aria-hidden="true"></svg>
            <span class="screen-error" aria-hidden="true"><strong>VIDEO SIGNAL LOST</strong><small>UNFORESEEN CONSEQUENCES / λ-17</small></span>
            <span class="screen-flash" aria-hidden="true"></span>
            <span class="monitor-hud"><span class="monitor-top" aria-hidden="true"><span><span class="record-dot"></span> LIVE FEED / CAM 01</span><span>CHAMBER 17</span></span><span class="monitor-bottom"><span aria-hidden="true">SUBJECT / M. TAMMEOJA</span><span class="monitor-status" aria-live="polite">SIGNAL STABLE</span></span></span>
          </button>
          <div class="monitor-chin" aria-hidden="true"><svg class="chin-mark" viewBox="0 0 64 64"><path d="M32 5 49.7 11.6 41.1 24.1 33.7 20.1Z M51.1 12.9 58.9 30.1 44 32.8 41.6 24.8Z M59 32 52.4 49.7 39.9 41.1 43.9 33.7Z M51.1 51.1 33.9 58.9 31.2 44 39.2 41.6Z M32 59 14.3 52.4 22.9 39.9 30.3 43.9Z M12.9 51.1 5.1 33.9 20 31.2 22.4 39.2Z M5 32 11.6 14.3 24.1 22.9 20.1 30.3Z M12.9 12.9 30.1 5.1 32.8 20 24.8 22.4Z"/></svg><span class="power-led"></span></div>
        </div>
        <div class="tool-bay"><span>AUTHORIZED EQUIPMENT / λ-01 <span aria-hidden="true">↗</span></span><button class="crowbar-tool" type="button" aria-label="Pick up crowbar. You can also drag it onto the monitor."><img src="/crowbar-pixel-v3.png" width="124" height="27" alt="" /><span class="crowbar-label">TAKE CROWBAR</span></button></div>
      </div>
    </section>

    <div class="marquee-rule wrap"><span><span class="lambda-mark" aria-hidden="true"><span>λ</span></span> CODE, PEOPLE, SYSTEMS</span><span>SCROLL TO EXPLORE ↓</span></div>

    <section class="section wrap" id="experience" aria-labelledby="experience-title">
      <div class="section-intro"><p class="section-label">01 / EXPERIENCE</p><div><h2 id="experience-title">The test log<span class="accent">.</span></h2><p>From university to the systems I work on today.</p></div></div>
      <div class="timeline">{experience.map((item) => <TimelineEntry {...item} />)}</div>
    </section>

    <aside class="cube-station wrap" id="intermission" aria-label="Companion cube interaction">
      <div class="cube-station-head"><span>INTERMISSION / 001</span><span>CLICK FOR DIALOGUE ↓</span></div>
      <div class="cube-stage">
        <p class="cube-chat" aria-live="polite"></p>
        <button class="companion-cube" type="button" aria-label="Talk to the companion cube"><img src="/companion-cube-pixel.png" width="256" height="256" alt="" loading="lazy" /></button>
      </div>
      <p class="cube-station-caption">COMPANION CUBE / RANDOM EVENT</p>
    </aside>

    <section class="projects-section" id="projects" aria-labelledby="projects-title">
      <div class="wrap">
        <div class="section-intro"><p class="section-label">02 / PROJECTS</p><div><h2 id="projects-title">Out of the lab<span class="accent">.</span></h2><p>Selected apps and tools I've built and put to use.</p></div></div>
        <div class="projects-grid">{projects.map((project) => <ProjectCard {...project} />)}</div>
      </div>
    </section>

    <section class="about-section wrap" id="about" aria-labelledby="about-title">
      <div class="section-intro"><p class="section-label">03 / ABOUT</p><div><h2 id="about-title">Behind the panel<span class="accent">.</span></h2></div></div>
      <div class="about-grid">
        <div class="about-lead-wrap"><p class="about-lead">I like knowing how the whole thing works.</p><div class="specimen-chip" aria-hidden="true"><img src="/xen-specimen.png" width="704" height="445" alt="" loading="lazy" /><span>XEN / SPECIMEN 01</span></div></div>
        <div class="about-body">
          <p><strong>I daily-drive Linux</strong> and run services on my own servers. I like knowing how an app gets deployed, what happens when something breaks and how to make it easier to operate.</p>
          <p>I build my own things too. Ampsu is the biggest of them, and it lets me work on every part of a product, mostly in Kotlin, which is still my favourite language.</p>
          <p>Outside of work, I cycle, work out, hike and camp. I love food, board games and Magic: The Gathering. I'm a <a href="https://www.valvesoftware.com/en/about" target="_blank" rel="noopener noreferrer">Valve</a> fanatic (you may have noticed), and I always end up back in RuneScape eventually.</p>
        </div>
      </div>
      <div class="about-links"><ArrowLink href="https://www.linkedin.com/in/tammeoja/" label="LinkedIn" /><ArrowLink href="https://github.com/Uptaker" label="GitHub" /><PortalLink href="#top" tone="orange" label="RETURN PORTAL" description="Enter the orange portal to return to the top" /></div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-top">
        <div><p class="footer-kicker">CONTACT</p><a class="footer-mail" href="mailto:markus.tammeoja@gmail.com">markus.tammeoja@gmail.com</a></div>
        <figure class="footer-cats">
          <a class="footer-cats-trigger" href="/cats.webp" aria-label="View a larger photo of my cats"><img src="/cats.webp" width="900" height="1200" alt="My two cats curled up together on a couch" loading="lazy" decoding="async" /><span class="cats-monitor-top" aria-hidden="true"><span><span class="record-dot"></span> CAM 02 / BREAK ROOM</span><span>LIVE</span></span></a>
          <figcaption>THE CATS / CHAMBER COMPANIONS</figcaption>
          <div class="monitor-chin" aria-hidden="true"><svg class="chin-mark" viewBox="0 0 64 64"><path d="M32 5 49.7 11.6 41.1 24.1 33.7 20.1Z M51.1 12.9 58.9 30.1 44 32.8 41.6 24.8Z M59 32 52.4 49.7 39.9 41.1 43.9 33.7Z M51.1 51.1 33.9 58.9 31.2 44 39.2 41.6Z M32 59 14.3 52.4 22.9 39.9 30.3 43.9Z M12.9 51.1 5.1 33.9 20 31.2 22.4 39.2Z M5 32 11.6 14.3 24.1 22.9 20.1 30.3Z M12.9 12.9 30.1 5.1 32.8 20 24.8 22.4Z"/></svg><span class="power-led"></span></div>
        </figure>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Markus Tammeoja</span><a href="#top">Back to top ↑</a></div>
    </div>
  </footer>

  <dialog class="cats-dialog" aria-label="Larger photo of my cats">
    <form method="dialog"><button class="cats-dialog-close" aria-label="Close photo">×</button></form>
    <img src="/cats.webp" width="900" height="1200" alt="My two cats curled up together on a couch" loading="lazy" decoding="async" />
  </dialog>

  <script>
    import { unlock } from '../scripts/achievements';

    console.log(
      String.raw`%c /\_/\
( o.o )
 > ^ <

Quest complete: you found the console.
The cats are at the bottom of the page.`,
      'color: #a9bca6; font: 14px monospace'
    );

    const catsDialog = document.querySelector<HTMLDialogElement>('.cats-dialog');
    const catsTrigger = document.querySelector<HTMLAnchorElement>('.footer-cats-trigger');
    const cube = document.querySelector<HTMLButtonElement>('.companion-cube');
    const cubeChat = document.querySelector<HTMLElement>('.cube-chat');

    if (cube && cubeChat) {
      const phrases = [
        'Fishing lvl?',
        'Doubling money!',
        'Buying gf 10k.',
        '92 is half of 99.',
        'Meet me in Lumbridge.',
        'Selling lobbies 200 ea.',
        'Free armour trimming!',
        'Bank sale! West Varrock!',
        'Dragon med helm, no lowballs.',
        "You can't use that here.",
        'Nothing interesting happens.',
        'Welcome to the Wilderness.',
        'Just one more level.',
        'My bank is full again.',
        'Quest complete!',
        'Your run energy is low.',
        'The Grand Exchange awaits.',
        'AFK for five minutes.',
        'Why am I still chopping yews?',
        'Connection lost. Please wait...'
      ];
      let remaining: number[] = [];
      let last = -1;
      let chatTimer = 0;
      let clicks = 0;

      cube.addEventListener('click', () => {
        if (++clicks === 10) unlock('companion');
        if (!remaining.length) {
          remaining = phrases.map((_, index) => index);
          for (let i = remaining.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [remaining[i], remaining[j]] = [remaining[j], remaining[i]];
          }
          if (remaining.at(-1) === last) [remaining[0], remaining[remaining.length - 1]] = [remaining[remaining.length - 1], remaining[0]];
        }
        last = remaining.pop()!;
        cubeChat.textContent = phrases[last];
        cubeChat.classList.remove('is-visible');
        cube.classList.remove('is-loved');
        void cube.offsetWidth;
        cubeChat.classList.add('is-visible');
        cube.classList.add('is-loved');
        window.clearTimeout(chatTimer);
        chatTimer = window.setTimeout(() => cubeChat.classList.remove('is-visible'), 5000);
      });
    }

    const crowbar = document.querySelector<HTMLButtonElement>('.crowbar-tool');
    const display = document.querySelector<HTMLButtonElement>('.monitor-display');
    const monitor = document.querySelector<HTMLElement>('.monitor-shell');
    const monitorStatus = document.querySelector<HTMLElement>('.monitor-status');
    const crowbarLabel = document.querySelector<HTMLElement>('.crowbar-label');
    const cracks = document.querySelector<SVGSVGElement>('.screen-cracks');

    if (crowbar && display && monitor && monitorStatus && crowbarLabel && cracks) {
      let armed = false;
      let broken = false;
      let impacts = 0;
      let dragStart: { x: number; y: number } | null = null;
      let dragged = false;
      let skipClick = false;
      let hitTimer = 0;
      let recoverTimer = 0;
      let statusTimer = 0;

      const svgElement = (name: string) => document.createElementNS('http://www.w3.org/2000/svg', name);
      const addPath = (parent: SVGElement, d: string, stroke: string, width: number, opacity = 1, fill = 'none') => {
        const path = svgElement('path');
        path.setAttribute('d', d);
        path.setAttribute('stroke', stroke);
        path.setAttribute('stroke-width', String(width));
        path.setAttribute('stroke-opacity', String(opacity));
        path.setAttribute('fill', fill);
        path.setAttribute('stroke-linejoin', 'round');
        parent.append(path);
      };

      const addImpact = (clientX: number, clientY: number, centered = false) => {
        const box = display.getBoundingClientRect();
        const x = centered ? 250 : Math.max(12, Math.min(488, (clientX - box.left) / box.width * 500));
        const y = centered ? 290 : Math.max(12, Math.min(568, (clientY - box.top) / box.height * 580));
        const group = svgElement('g');
        group.setAttribute('transform', `translate(${x} ${y}) rotate(${Math.random() * 360})`);
        const count = 7 + Math.floor(Math.random() * 3);
        const bleed = svgElement('path');
        const bleedShape = Array.from({ length: 15 }, (_, i) => {
          const angle = i * Math.PI * 2 / 15;
          const radius = 22 + Math.random() * 24;
          return `${(Math.cos(angle) * radius).toFixed(1)} ${(Math.sin(angle) * radius).toFixed(1)}`;
        }).join(' L');
        bleed.setAttribute('d', `M${bleedShape}Z`);
        bleed.setAttribute('fill', '#020608');
        bleed.setAttribute('fill-opacity', '.7');
        group.append(bleed);

        for (let i = 0; i < count; i++) {
          const angle = i * Math.PI * 2 / count + (Math.random() - .5) * .35;
          const point = (length: number, drift = 0) => `${(Math.cos(angle + drift) * length).toFixed(1)} ${(Math.sin(angle + drift) * length).toFixed(1)}`;
          const near = 22 + Math.random() * 18;
          const inner = 50 + Math.random() * 35;
          const middle = 95 + Math.random() * 65;
          const far = i % 3 === 0 ? 130 + Math.random() * 70 : 210 + Math.random() * 150;
          const lengths = [0, near, inner, (inner + middle) / 2, middle, (middle + far) / 2, far];
          const d = `M${lengths.map((length, index) => point(length, index < 2 ? 0 : (Math.random() - .5) * .14 * index)).join(' L')}`;
          addPath(group, d, '#02080a', 2.8, .85);
          addPath(group, d, '#e7f5f6', .9 + Math.random() * .7, .55 + Math.random() * .3);
          for (const base of [inner, middle]) {
            const branchAngle = angle + (Math.random() < .5 ? -1 : 1) * (.3 + Math.random() * .6);
            const branchLength = base + 25 + Math.random() * 70;
            const branch = `M${point(base, (Math.random() - .5) * .15)} L${(Math.cos((angle + branchAngle) / 2) * (base + branchLength) / 2).toFixed(1)} ${(Math.sin((angle + branchAngle) / 2) * (base + branchLength) / 2).toFixed(1)} L${(Math.cos(branchAngle) * branchLength).toFixed(1)} ${(Math.sin(branchAngle) * branchLength).toFixed(1)}`;
            addPath(group, branch, '#d2e9e9', .7 + Math.random() * .6, .3 + Math.random() * .35);
          }
        }

        for (let i = 0; i < 5; i++) {
          const angle = Math.random() * Math.PI * 2;
          const radius = 35 + Math.random() * 85;
          const arc = [0, .22, .48].map((offset) => {
            const distance = radius + (Math.random() - .5) * 12;
            return `${(Math.cos(angle + offset) * distance).toFixed(1)} ${(Math.sin(angle + offset) * distance).toFixed(1)}`;
          }).join(' L');
          addPath(group, `M${arc}`, '#b9d5d7', .7, .3 + Math.random() * .3);
        }

        const ring = Array.from({ length: 11 }, (_, i) => {
          const angle = i * Math.PI * 2 / 11;
          const radius = 19 + Math.random() * 10;
          return `${(Math.cos(angle) * radius).toFixed(1)} ${(Math.sin(angle) * radius).toFixed(1)}`;
        }).join(' L');
        addPath(group, `M${ring}Z`, '#d9eeef', 1.6, .8);
        const hole = Array.from({ length: 10 }, (_, i) => {
          const angle = i * Math.PI * 2 / 10;
          const radius = 9 + Math.random() * 8;
          return `${(Math.cos(angle) * radius).toFixed(1)} ${(Math.sin(angle) * radius).toFixed(1)}`;
        }).join(' L');
        addPath(group, `M${hole}Z`, '#03080a', 1.2, 1, '#03080a');
        cracks.append(group);
        if (cracks.children.length > 5) cracks.firstElementChild?.remove();
        monitor.style.setProperty('--impact-x', `${x / 5}%`);
        monitor.style.setProperty('--impact-y', `${y / 5.8}%`);
      };

      const setArmed = (value: boolean) => {
        armed = value;
        display.disabled = !value;
        if (value) unlock('trusty-hardware');
        monitor.classList.toggle('is-armed', value);
        crowbar.classList.toggle('is-armed', value);
        monitorStatus.textContent = broken ? 'DISPLAY COMPROMISED' : value ? 'CROWBAR EQUIPPED' : 'SIGNAL STABLE';
        crowbarLabel.textContent = broken ? 'RESTORE DISPLAY' : value ? 'DROP CROWBAR' : 'TAKE CROWBAR';
        crowbar.setAttribute('aria-label', broken ? 'Restore chamber display' : value ? 'Drop crowbar' : 'Pick up crowbar. You can also drag it onto the monitor.');
      };

      const hitScreen = (clientX: number, clientY: number, centered = false) => {
        if (!armed) return;
        addImpact(clientX, clientY, centered);
        impacts++;
        if (!broken) console.log('%cλ UNFORESEEN CONSEQUENCES', 'color: #ed9652; font: 700 15px monospace');
        unlock('unforeseen-consequences');
        broken = true;
        monitor.classList.add('is-broken');
        monitorStatus.textContent = 'DISPLAY COMPROMISED';
        crowbarLabel.textContent = 'RESTORE DISPLAY';
        crowbar.setAttribute('aria-label', 'Restore chamber display');
        display.setAttribute('aria-label', `Chamber monitor with ${impacts} impact${impacts === 1 ? '' : 's'}. Click again to add another.`);
        monitor.classList.remove('is-hitting');
        void monitor.offsetWidth;
        monitor.classList.add('is-hitting');
        window.clearTimeout(hitTimer);
        hitTimer = window.setTimeout(() => monitor.classList.remove('is-hitting'), 450);
        window.clearTimeout(recoverTimer);
        recoverTimer = window.setTimeout(recover, 15000);
      };

      const restore = () => {
        broken = false;
        impacts = 0;
        cracks.replaceChildren();
        monitor.classList.remove('is-broken', 'is-hitting', 'is-recovering');
        window.clearTimeout(hitTimer);
        window.clearTimeout(recoverTimer);
        window.clearTimeout(statusTimer);
        display.setAttribute('aria-label', 'Chamber monitor showing Markus Tammeoja. Pick up the crowbar to interact with it.');
        setArmed(false);
      };

      const recover = () => {
        monitor.classList.add('is-recovering');
        recoverTimer = window.setTimeout(() => {
          restore();
          monitorStatus.textContent = 'SIGNAL RESTORED';
          statusTimer = window.setTimeout(() => { if (!armed && !broken) monitorStatus.textContent = 'SIGNAL STABLE'; }, 3000);
        }, 900);
      };

      crowbar.addEventListener('click', (event) => {
        if (skipClick) { skipClick = false; return; }
        if (broken) {
          restore();
        } else {
          setArmed(!armed);
          if (armed && event.detail === 0) display.focus();
        }
      });

      display.addEventListener('click', (event) => hitScreen(event.clientX, event.clientY, event.detail === 0));
      crowbar.addEventListener('pointerdown', (event) => {
        dragStart = { x: event.clientX, y: event.clientY };
        dragged = false;
        crowbar.setPointerCapture(event.pointerId);
      });
      crowbar.addEventListener('pointermove', (event) => {
        if (!dragStart) return;
        const x = event.clientX - dragStart.x;
        const y = event.clientY - dragStart.y;
        if (Math.hypot(x, y) > 8) dragged = true;
        if (dragged) crowbar.style.translate = `${x}px ${y}px`;
      });
      crowbar.addEventListener('pointerup', (event) => {
        if (!dragStart) return;
        if (dragged) {
          const box = display.getBoundingClientRect();
          if (event.clientX >= box.left && event.clientX <= box.right && event.clientY >= box.top && event.clientY <= box.bottom) {
            setArmed(true);
            hitScreen(event.clientX, event.clientY);
          }
          skipClick = true;
          window.setTimeout(() => { skipClick = false; }, 0);
          crowbar.style.translate = '';
        }
        dragStart = null;
      });
      crowbar.addEventListener('pointercancel', () => { dragStart = null; crowbar.style.translate = ''; });
    }

    if (catsDialog && catsTrigger && typeof catsDialog.showModal === 'function') {
      catsTrigger.addEventListener('click', (event) => {
        event.preventDefault();
        catsDialog.showModal();
        unlock('what-cat');
      });
      catsDialog.addEventListener('click', (event) => {
        if (event.target === catsDialog) catsDialog.close();
      });
    }

    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });

      for (const entry of document.querySelectorAll('.timeline-entry')) {
        if (entry.getBoundingClientRect().top > window.innerHeight * .85) {
          entry.classList.add('reveal-ready');
          observer.observe(entry);
        }
      }
    }
  </script>
</BaseLayout>
